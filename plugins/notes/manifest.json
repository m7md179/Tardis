{
  "name": "notes",
  "version": "1.0.0",
  "displayName": "Notes",
  "description": "Save and recall quick notes and facts. Acts as a personal knowledge base.",
  "summary": "Save and recall quick notes and facts. Acts as a personal knowledge base the assistant can reference later. Supports tagging and full-text search.",
  "tier": 1,
  "main": "index.ts",
  "permissions": [
    "storage:read",
    "storage:write"
  ],
  "skills": [
    {
      "id": "notes.save-note",
      "description": "Save a new note or overwrite an existing one with the same title. Use when the user wants to remember something.",
      "aiInvocable": true,
      "actionType": "direct",
      "mutates": true,
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Short title / key for the note (used to retrieve it later)"
          },
          "content": {
            "type": "string",
            "description": "The note content"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional tags to categorize the note (e.g. [\"work\", \"contacts\"])"
          }
        },
        "required": [
          "title",
          "content"
        ]
      },
      "ui": {
        "block": "form",
        "label": "New note",
        "icon": "edit",
        "submitLabel": "Save",
        "fields": [
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "required": true
          },
          {
            "name": "content",
            "type": "textarea",
            "label": "Note",
            "required": true
          },
          {
            "name": "tags",
            "type": "tags",
            "label": "Tags"
          }
        ]
      }
    },
    {
      "id": "notes.get-note",
      "description": "Retrieve a specific note by its exact title.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the note to retrieve"
          }
        },
        "required": [
          "title"
        ]
      },
      "ui": {
        "block": "detail",
        "label": "Note",
        "icon": "file-text",
        "item": {
          "title": "title",
          "body": "content",
          "meta": [
            "tags",
            "updatedAt"
          ]
        }
      }
    },
    {
      "id": "notes.search-notes",
      "description": "Search notes by keyword (searches title, content, and tags).",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keyword or phrase"
          },
          "tag": {
            "type": "string",
            "description": "Optional: filter results by this tag"
          }
        },
        "required": [
          "query"
        ]
      },
      "ui": {
        "block": "form",
        "label": "Search notes",
        "icon": "search",
        "submitLabel": "Search",
        "fields": [
          {
            "name": "query",
            "type": "text",
            "label": "Search for",
            "required": true
          },
          {
            "name": "tag",
            "type": "text",
            "label": "Limit to tag"
          }
        ]
      }
    },
    {
      "id": "notes.list-notes",
      "description": "List all saved notes (titles, tags, and timestamps).",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "description": "Optional: filter by this tag"
          },
          "limit": {
            "type": "number",
            "description": "Max notes to return (default 20)"
          }
        }
      },
      "ui": {
        "block": "list",
        "label": "Notes",
        "icon": "file-text",
        "resultPath": "notes",
        "emptyText": "No notes saved yet.",
        "item": {
          "id": "title",
          "title": "title",
          "subtitle": "preview",
          "meta": [
            "tags",
            "updatedAt"
          ]
        },
        "actions": [
          {
            "skill": "notes.get-note",
            "label": "Open",
            "style": "secondary",
            "args": {
              "title": "title"
            }
          },
          {
            "skill": "notes.delete-note",
            "label": "Delete",
            "style": "danger",
            "args": {
              "title": "title"
            }
          }
        ]
      }
    },
    {
      "id": "notes.delete-note",
      "description": "Permanently delete a note by its title.",
      "aiInvocable": true,
      "actionType": "workflow",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the note to delete"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  ]
}
