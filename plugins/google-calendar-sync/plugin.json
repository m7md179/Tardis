{
  "name": "google-calendar-sync",
  "version": "1.0.0",
  "displayName": "Google Calendar Sync",
  "description": "Automatically sync completed TARDIS sessions to Google Calendar as events",
  "author": "Mohammad <mohammad@weborbit.dev>",
  "license": "MIT",
  "tardisVersion": ">=2.0.0",
  "main": "index.ts",
  "dependencies": {
    "googleapis": "^128.0.0"
  },
  "permissions": [
    "sessions:read",
    "storage:read",
    "storage:write",
    "http:external",
    "notifications:send"
  ],
  "hooks": [
    "session:stop"
  ],
  "commands": [
    {
      "name": "setup",
      "description": "Configure Google Calendar OAuth credentials"
    },
    {
      "name": "sync-all",
      "description": "Manually sync all recent sessions to Google Calendar"
    },
    {
      "name": "status",
      "description": "Show sync status and configuration"
    }
  ],
  "config": {
    "enabled": true,
    "autoSync": true,
    "calendarId": "primary"
  }
}
