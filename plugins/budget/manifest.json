{
  "name": "budget",
  "version": "1.0.0",
  "displayName": "Budget",
  "description": "Track spending, savings goals and whether you can afford the rest of the month.",
  "summary": "Money: spending, budgets, savings goals, fixed monthly outgoings and cards. Logs spending said in passing like 'spent 45 on groceries'. Tracks savings goals (car, trip, GPU) and whether you are on pace. Knows fixed commitments like savings and family support. Answers whether you can afford or survive the rest of the month, warns about overspending, and reports habits. Records transfers between your own cards, which are not spending, and imports bank SMS.",
  "tier": 2,
  "main": "index.ts",
  "permissions": [
    "storage:read",
    "storage:write",
    "llm:use"
  ],
  "config": {
    "currency": "JOD"
  },
  "skills": [
    {
      "id": "budget.log-spend",
      "description": "Record spending from a natural sentence, e.g. 'spent 45 on groceries at Tesco'. Extracts amount, category and merchant.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "What was spent, in plain language"
          }
        },
        "required": [
          "text"
        ]
      },
      "ui": {
        "block": "form",
        "label": "Log spending",
        "icon": "wallet",
        "submitLabel": "Log",
        "fields": [
          {
            "name": "text",
            "type": "text",
            "label": "What did you spend?",
            "required": true,
            "placeholder": "45 on groceries at Tesco"
          }
        ]
      }
    },
    {
      "id": "budget.add-entry",
      "description": "Record spending with the amount and category given explicitly. No interpretation.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Amount spent"
          },
          "category": {
            "type": "string",
            "description": "Category, e.g. groceries, transport, eating-out"
          },
          "description": {
            "type": "string",
            "description": "What it was for"
          }
        },
        "required": [
          "amount",
          "category"
        ]
      },
      "ui": {
        "block": "form",
        "label": "Add entry",
        "icon": "plus",
        "submitLabel": "Add",
        "fields": [
          {
            "name": "amount",
            "type": "number",
            "label": "Amount",
            "required": true,
            "min": 0
          },
          {
            "name": "category",
            "type": "select",
            "label": "Category",
            "required": true,
            "options": [
              {
                "value": "groceries",
                "label": "Groceries"
              },
              {
                "value": "eating-out",
                "label": "Eating out"
              },
              {
                "value": "transport",
                "label": "Transport"
              },
              {
                "value": "bills",
                "label": "Bills"
              },
              {
                "value": "shopping",
                "label": "Shopping"
              },
              {
                "value": "health",
                "label": "Health"
              },
              {
                "value": "other",
                "label": "Other"
              }
            ]
          },
          {
            "name": "description",
            "type": "text",
            "label": "What for"
          }
        ]
      }
    },
    {
      "id": "budget.this-month",
      "description": "List this month's spending entries with a running total.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "ui": {
        "block": "list",
        "label": "This month",
        "icon": "wallet",
        "resultPath": "entries",
        "emptyText": "Nothing recorded this month.",
        "item": {
          "id": "id",
          "title": "summary",
          "subtitle": "description",
          "meta": [
            "category",
            "loggedAt"
          ]
        },
        "actions": [
          {
            "skill": "budget.delete-entry",
            "label": "Delete",
            "style": "danger",
            "args": {
              "id": "id"
            }
          }
        ]
      }
    },
    {
      "id": "budget.summary",
      "description": "Spending totals grouped by category for a given month.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "description": "Month as YYYY-MM. Defaults to the current month."
          }
        }
      },
      "ui": {
        "block": "list",
        "label": "By category",
        "icon": "chart",
        "resultPath": "categories",
        "emptyText": "Nothing recorded.",
        "item": {
          "id": "category",
          "title": "category",
          "subtitle": "summary",
          "meta": [
            "share"
          ]
        }
      }
    },
    {
      "id": "budget.delete-entry",
      "description": "Delete a spending entry by its id.",
      "aiInvocable": true,
      "actionType": "workflow",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Entry id to delete"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "id": "budget.status",
      "description": "Whether you can survive the month: burn rate, projection to month end, and any category over its limit.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "ui": {
        "block": "list",
        "label": "Can I survive the month?",
        "icon": "gauge",
        "resultPath": "lines",
        "emptyText": "Set your income first.",
        "item": {
          "id": "key",
          "title": "headline",
          "subtitle": "detail"
        }
      }
    },
    {
      "id": "budget.setup",
      "description": "Set monthly income, the minimum you want left at month end, and your own name as the bank writes it so transfers to yourself are not counted as spending.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "monthlyIncome": {
            "type": "number",
            "description": "Money coming in each month"
          },
          "safeFloor": {
            "type": "number",
            "description": "Minimum you want left at month end"
          },
          "ownerName": {
            "type": "string",
            "description": "Your name exactly as it appears in bank SMS, e.g. 'MOHAMMAD K M MOHAMMADTAHA'"
          }
        },
        "required": [
          "monthlyIncome"
        ]
      },
      "ui": {
        "block": "form",
        "label": "Monthly budget",
        "icon": "gauge",
        "submitLabel": "Save",
        "fields": [
          {
            "name": "monthlyIncome",
            "type": "number",
            "label": "Monthly income",
            "required": true,
            "min": 0
          },
          {
            "name": "safeFloor",
            "type": "number",
            "label": "Keep at least",
            "min": 0
          },
          {
            "name": "ownerName",
            "type": "text",
            "label": "Your name as the bank writes it",
            "placeholder": "MOHAMMAD K M MOHAMMADTAHA"
          }
        ]
      }
    },
