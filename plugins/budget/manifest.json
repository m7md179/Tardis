        "submitLabel": "Create",
        "fields": [
          {
            "name": "name",
            "type": "text",
            "label": "Saving for",
            "required": true,
            "placeholder": "GPU"
          },
          {
            "name": "target",
            "type": "number",
            "label": "Target amount",
            "required": true,
            "min": 0
          },
          {
            "name": "deadline",
            "type": "date",
            "label": "Want it by"
          },
          {
            "name": "monthlyPayment",
            "type": "number",
            "label": "Monthly payment after buying",
            "min": 0
          }
        ]
      }
    },
