    {
      "id": "budget.add-goal",
      "description": "Start saving for something: a car, a trip, a GPU. Target amount and optional deadline.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "What you are saving for"
