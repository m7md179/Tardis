          "target": {
            "type": "number",
            "description": "Total amount needed"
          },
          "deadline": {
            "type": "string",
            "description": "Optional target date, YYYY-MM-DD"
          },
          "monthlyPayment": {
            "type": "number",
            "description": "Optional recurring payment once bought, e.g. car finance"
          }
