{
  "name": "google-calendar",
  "version": "1.0.0",
  "displayName": "Google Calendar",
  "description": "Manage Google Calendar events: list upcoming schedule, create events, check what's on a specific date.",
  "summary": "Manage Google Calendar events. Create new events, list upcoming schedule, and check what's happening on specific dates or tomorrow. Also handles Google Calendar OAuth2 authorization setup and exchanging authorization codes to connect the calendar.",
  "tier": 1,
  "main": "index.ts",
  "permissions": [
    "http:external",
    "storage:read",
    "storage:write",
    "notifications:send"
  ],
  "skills": [
    {
      "id": "google-calendar.list-events",
      "description": "List upcoming calendar events. Can filter by date range.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date to check (YYYY-MM-DD). Defaults to today. Use 'tomorrow' or a specific date."
          },
          "days": {
            "type": "number",
            "description": "Number of days to look ahead (default 1). Use 7 for a week view."
          },
          "maxResults": {
            "type": "number",
            "description": "Maximum events to return (default 10)."
          }
        }
      },
      "ui": {
        "block": "list",
        "label": "Calendar",
        "icon": "calendar",
        "resultPath": "events",
        "emptyText": "No events.",
        "item": {
          "id": "id",
          "title": "summary",
          "subtitle": "start",
          "meta": [
            "location"
          ]
        },
        "actions": [
          {
            "skill": "google-calendar.delete-event",
            "label": "Delete",
            "style": "danger",
            "args": {
              "eventTitle": "summary"
            }
          }
        ]
      }
    },
    {
      "id": "google-calendar.create-event",
      "description": "Create a new calendar event.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Event title/summary"
          },
          "date": {
            "type": "string",
            "description": "Event date (YYYY-MM-DD)"
          },
          "startTime": {
            "type": "string",
            "description": "Start time (HH:MM, 24h format). Omit for all-day event."
          },
          "endTime": {
            "type": "string",
            "description": "End time (HH:MM, 24h format). Defaults to 1 hour after start."
          },
          "description": {
            "type": "string",
            "description": "Optional event description"
          },
          "location": {
            "type": "string",
            "description": "Optional event location"
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of attendee email addresses"
          }
        },
        "required": [
          "title",
          "date"
        ]
      },
      "ui": {
        "block": "form",
        "label": "New event",
        "icon": "calendar-plus",
        "submitLabel": "Create",
        "fields": [
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "required": true
          },
          {
            "name": "date",
            "type": "date",
            "label": "Date",
            "required": true
          },
          {
            "name": "startTime",
            "type": "time",
            "label": "Start"
          },
          {
            "name": "endTime",
            "type": "time",
            "label": "End"
          },
          {
            "name": "location",
            "type": "text",
            "label": "Location"
          },
          {
            "name": "description",
            "type": "textarea",
            "label": "Description"
          }
        ]
      }
    },
    {
      "id": "google-calendar.check-schedule",
      "description": "Check if a specific time slot is free or busy.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date to check (YYYY-MM-DD)"
          },
          "startTime": {
            "type": "string",
            "description": "Start time to check (HH:MM)"
          },
          "endTime": {
            "type": "string",
            "description": "End time to check (HH:MM)"
          }
        },
        "required": [
          "date",
          "startTime",
          "endTime"
        ]
      },
      "ui": {
        "block": "form",
        "label": "Check availability",
        "icon": "calendar-check",
        "submitLabel": "Check",
        "fields": [
          {
            "name": "date",
            "type": "date",
            "label": "Date",
            "required": true
          },
          {
            "name": "startTime",
            "type": "time",
            "label": "From",
            "required": true
          },
          {
            "name": "endTime",
            "type": "time",
            "label": "To",
            "required": true
          }
        ]
      }
    },
    {
      "id": "google-calendar.update-event",
      "description": "Update an existing upcoming calendar event. Use this to reschedule, rename, or change the time of an event. Find the event by title.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "eventTitle": {
            "type": "string",
            "description": "Title (or partial title) of the event to find and update"
          },
          "newTitle": {
            "type": "string",
            "description": "New title for the event"
          },
          "newDate": {
            "type": "string",
            "description": "New date (YYYY-MM-DD). Use 'tomorrow', 'today', or a specific date."
          },
          "newStartTime": {
            "type": "string",
            "description": "New start time (HH:MM, 24h format)"
          },
          "newEndTime": {
            "type": "string",
            "description": "New end time (HH:MM, 24h format)"
          }
        },
        "required": [
          "eventTitle"
        ]
      },
      "ui": {
        "block": "form",
        "label": "Update event",
        "icon": "edit",
        "submitLabel": "Save",
        "fields": [
          {
            "name": "eventTitle",
            "type": "text",
            "label": "Event to update",
            "required": true
          },
          {
            "name": "newTitle",
            "type": "text",
            "label": "New title"
          },
          {
            "name": "newDate",
            "type": "date",
            "label": "New date"
          },
          {
            "name": "newStartTime",
            "type": "time",
            "label": "New start"
          },
          {
            "name": "newEndTime",
            "type": "time",
            "label": "New end"
          }
        ]
      }
    },
    {
      "id": "google-calendar.delete-event",
      "description": "Delete an upcoming calendar event by title. This permanently removes it from Google Calendar.",
      "aiInvocable": true,
      "actionType": "workflow",
      "parameters": {
        "type": "object",
        "properties": {
          "eventTitle": {
            "type": "string",
            "description": "Title (or partial title) of the event to delete"
          }
        },
        "required": [
          "eventTitle"
        ]
      }
    },
    {
      "id": "google-calendar.setup-oauth",
      "description": "Start the OAuth2 setup flow to connect Google Calendar. Call this if Google Calendar is not yet authorized.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "ui": {
        "block": "action",
        "label": "Connect Google Calendar",
        "icon": "link",
        "args": {}
      }
    },
    {
      "id": "google-calendar.exchange-code",
      "description": "Exchange the OAuth2 authorization code to complete Google Calendar connection. Call this immediately when the user provides a Google authorization code (typically starts with '4/1' or '4/'). Do not ask for more info \u2014 just call this tool with the code.",
      "aiInvocable": true,
      "actionType": "direct",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The authorization code from Google (starts with '4/')"
          }
        },
        "required": [
          "code"
        ]
      },
      "ui": {
        "block": "form",
        "label": "Finish connecting",
        "icon": "key",
        "submitLabel": "Connect",
        "fields": [
          {
            "name": "code",
            "type": "text",
            "label": "Authorization code",
            "required": true
          }
        ]
      }
    }
  ]
}
