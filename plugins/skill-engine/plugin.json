{
  "name": "skill-engine",
  "version": "1.0.0",
  "displayName": "Skill Engine",
  "description": "Self-evolving skill tracking with adaptive training and analytics",
  "tardisVersion": ">=2.0.0",
  "main": "index.ts",
  "permissions": [
    "db:read",
    "db:write",
    "storage:read",
    "storage:write",
    "tasks:read",
    "tasks:write",
    "notifications:send",
    "sessions:read"
  ],
  "hooks": ["session:stop"],
  "commands": [
    {
      "name": "add-skill",
      "args": "<name> [category]",
      "description": "Add a new skill to track"
    },
    {
      "name": "remove-skill",
      "args": "<name>",
      "description": "Remove a tracked skill"
    },
    {
      "name": "skills",
      "description": "List all tracked skills with levels"
    },
    {
      "name": "train",
      "args": "<skill> [type]",
      "description": "Start a training session"
    },
    {
      "name": "complete-training",
      "args": "<score>",
      "description": "Complete current training with score (0-100%)"
    },
    {
      "name": "progress",
      "args": "[skill]",
      "description": "Show progress report for a skill or all skills"
    },
    {
      "name": "weak-areas",
      "args": "[skill]",
      "description": "Show detected weak areas"
    },
    {
      "name": "stats",
      "args": "[period]",
      "description": "Show analytics (daily/weekly/monthly)"
    },
    {
      "name": "calibrate",
      "args": "[target]",
      "description": "View or set difficulty calibration target"
    },
    {
      "name": "config",
      "args": "[key] [value]",
      "description": "View or set engine configuration"
    }
  ],
  "config": {
    "enabled": true,
    "targetSuccessRate": 0.85,
    "autoCreateTasks": true,
    "snapshotInterval": "daily",
    "notifyOnLevelUp": true,
    "notifyOnWeakness": true
  }
}
