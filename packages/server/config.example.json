{
  "server": {
    "host": "0.0.0.0",
    "port": 3000,
    "dataDir": "/var/lib/tardis"
  },
  "auth": {
    "jwtSecret": "REPLACE_WITH_32_CHAR_SECRET_FROM_GENERATE_SCRIPT",
    "jwtExpiry": "30d",
    "apiKeyLength": 32
  },
  "rateLimit": {
    "enabled": true,
    "windowMs": 60000,
    "maxRequests": 100
  },
  "scheduler": {
    "enabled": true,
    "todoistSyncInterval": 300,
    "timeWindowCheckInterval": 60
  },
  "todoist": {
    "apiToken": "YOUR_TODOIST_API_TOKEN_HERE"
  },
  "notifications": {
    "enabled": true,
    "channels": {
      "telegram": {
        "enabled": true,
        "botToken": "YOUR_TELEGRAM_BOT_TOKEN_HERE",
        "chatId": "YOUR_TELEGRAM_CHAT_ID_HERE"
      }
    }
  }
}
