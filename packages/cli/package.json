{
  "name": "@tardis/cli",
  "version": "2.0.0",
  "description": "TARDIS v2 CLI — command-line interface",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@tardis/core": "workspace:*",
    "@tardis/shared": "workspace:*",
    "commander": "^14.0.3",
    "inquirer": "^13.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.7.2"
  }
}
